# Credential injection end to end with the built binary: the proxy replaces
# the placeholder the workload sent at the placement, writes the credential
# where the workload sent nothing, refuses an endpoint whose credential the
# source does not hold, refuses a path no endpoint covers on the same
# tunnel, and puts no credential in a log line or an audit record.
#
# The credential source is a static file, which the process announces on
# every start and the admin socket reports.

[!exec:curl] skip 'curl is not installed'

upstream upstream
freeport PROXY_PORT
shortdir ADMIN_DIR

# A mounted emptyDir arrives at mode 0777, and the proxy binds the admin
# socket in it. The directory mode is what keeps another container in the
# pod off the socket, so the proxy sets it before it binds.
chmod 0777 $ADMIN_DIR

# The loader refuses a credential file that anyone but its owner can read.
chmod 0600 credentials.yaml

# The upstream binds a port the script cannot know in advance. The endpoint
# URLs and the credential resources name it, so both files are written with
# $UPSTREAM_PORT and expanded before the proxy reads them.
expand config.yaml
expand credentials.yaml

env EGRESS_PROXY_CONFIG=config.yaml
env EGRESS_PROXY_SANDBOX_ID=acceptance
env EGRESS_PROXY_CONNECT=127.0.0.1:$PROXY_PORT
env EGRESS_PROXY_ADMIN=$ADMIN_DIR/admin.sock
env EGRESS_PROXY_CA_OUT_DIR=$WORK/shared-ca
env EGRESS_PROXY_UPSTREAM_CA_FILES=$WORK/upstream/ca.crt
env EGRESS_PROXY_CREDENTIAL_STATIC_FILE=$WORK/credentials.yaml
exec egress-proxy &proxy&
waitfile shared-ca/ca.crt
waitport 127.0.0.1:$PROXY_PORT

env HTTPS_PROXY=http://127.0.0.1:$PROXY_PORT

# The admin socket names the source and does not hold a credential.
exec curl -sS --unix-socket $ADMIN_DIR/admin.sock http://admin/info
stdout '"credential_source": "a static file of 2 credentials'
! stdout 'sekrit'

# A header placement replaces the placeholder the workload sent.
exec curl -sS --cacert shared-ca/ca.crt -H 'Authorization: Bearer placeholder' https://localhost:$UPSTREAM_PORT/header/repos
stdout '^hello from upstream /header/repos$'

! exec curl -sS --cacert shared-ca/ca.crt https://localhost:$UPSTREAM_PORT/header/bad-trailer

# A query placement writes the parameter beside the ones the workload sent.
exec curl -sS --cacert shared-ca/ca.crt https://localhost:$UPSTREAM_PORT/query/geocode?q=here
stdout '^hello from upstream /query/geocode$'

# An endpoint that names no credential forwards what the workload sent.
exec curl -sS --cacert shared-ca/ca.crt -H 'Authorization: Bearer placeholder' https://localhost:$UPSTREAM_PORT/nocred/simple
stdout '^hello from upstream /nocred/simple$'

# A query the proxy cannot parse is refused before the credential is
# written. Forwarding it would drop the pairs that did not parse, so the
# upstream would receive a request the workload did not write.
exec curl -sS --cacert shared-ca/ca.crt -o /dev/null -w '%{http_code}' https://localhost:$UPSTREAM_PORT/query/badquery?bad=%zz
stdout '^400$'

# An endpoint whose resource the source does not hold is refused, and the
# request never reaches the upstream.
exec curl -sS --cacert shared-ca/ca.crt -o /dev/null -w '%{http_code}' https://localhost:$UPSTREAM_PORT/missing/thing
stdout '^403$'

# A path no endpoint covers, on the same tunnel the credentialed endpoints
# use. No endpoint matches, so no resource is named, no credential is
# written, and the request never reaches the upstream.
exec curl -sS --cacert shared-ca/ca.crt -o /dev/null -w '%{http_code}' -H 'Authorization: Bearer placeholder' https://localhost:$UPSTREAM_PORT/unlisted/thing
stdout '^403$'

# The upstream reports what arrived: the credential at each placement, the
# placeholder left alone where no endpoint names one, and no request for the
# refused endpoint.
grep 'request GET /header/repos host=localhost:\d+ authorization="Bearer header-sekrit"' upstream/requests.log
grep 'request GET /query/geocode\?key=query-sekrit&q=here host=localhost:\d+ authorization=""' upstream/requests.log
grep 'request GET /nocred/simple host=localhost:\d+ authorization="Bearer placeholder"' upstream/requests.log
! grep '/missing/thing' upstream/requests.log
! grep '/query/badquery' upstream/requests.log
! grep '/unlisted/thing' upstream/requests.log
grep 'request GET /header/bad-trailer host=localhost:\d+ authorization="Bearer header-sekrit"' upstream/requests.log
grep -count=4 '^request ' upstream/requests.log

sigterm
wait proxy

# The process announces the static source on every start.
stderr '"msg":"credential source"'
stderr 'a static file of 2 credentials'

# Every decision has an audit record. The record for the query placement
# names the path without its query, so the credential is in no record.
audit stdout scope=request request.path=/header/repos decision.reason=endpoint_allowed decision.endpoint=localhost:$UPSTREAM_PORT/header/ outcome.status=200
audit stdout scope=request request.path=/header/bad-trailer decision.verdict=allow decision.reason=endpoint_allowed outcome.error~.
audit stdout scope=request request.path=/query/geocode decision.reason=endpoint_allowed decision.endpoint=localhost:$UPSTREAM_PORT/query/ outcome.status=200
audit stdout scope=request request.path=/nocred/simple decision.reason=endpoint_allowed decision.endpoint=localhost:$UPSTREAM_PORT/nocred/ outcome.status=200
audit stdout scope=request request.path=/missing/thing decision.verdict=deny decision.reason=credential_unavailable decision.endpoint=localhost:$UPSTREAM_PORT/missing/
audit stdout scope=request request.path=/query/badquery decision.verdict=deny decision.reason=malformed_request
audit stdout scope=request request.path=/unlisted/thing decision.verdict=deny decision.reason=no_matching_endpoint
audit stdout 'decision.error~no credential for this resource'

# No credential reaches the audit stream on stdout or the log on stderr.
! stdout 'sekrit'
! stderr 'sekrit'

chmod 0600 malformed-credentials.yaml
env EGRESS_PROXY_CREDENTIAL_STATIC_FILE=$WORK/malformed-credentials.yaml
! exec egress-proxy
stderr 'invalid credential file'
! stderr 'startup-sekrit'

-- malformed-credentials.yaml --
version: 1
credentials:
  - resource: "https://localhost/header/"
    value: !!int startup-sekrit
-- config.yaml --
version: 1
policy:
  deny_list_exceptions: ["127.0.0.0/8", "::1/128"]
endpoints:
  - url: https://localhost:$UPSTREAM_PORT/header/
    credential:
      placement: {kind: header, name: Authorization, template: "Bearer {credential}"}
      env: HEADER_TOKEN
  - url: https://localhost:$UPSTREAM_PORT/query/
    credential:
      placement: {kind: query, name: key}
      env: QUERY_KEY
  - url: https://localhost:$UPSTREAM_PORT/nocred/
  - url: https://localhost:$UPSTREAM_PORT/missing/
    credential:
      placement: {kind: header, name: Authorization, template: "Bearer {credential}"}
      env: MISSING_TOKEN
-- credentials.yaml --
version: 1
credentials:
  - resource: "https://localhost:$UPSTREAM_PORT/header/"
    value: "header-sekrit"
  - resource: "https://localhost:$UPSTREAM_PORT/query/"
    value: "query-sekrit"
