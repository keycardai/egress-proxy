# The zone answers the exchange with a Keycard-API-Key or Keycard-Password
# token whose method says where the credential goes. The built binary writes
# it there and does not write the endpoint placement. A Bearer token still
# goes where the endpoint placement says. A token_type the proxy does not
# know, and a method that names a banned header, deny with
# credential_unavailable before the request reaches the upstream.

[!exec:curl] skip 'curl is not installed'

upstream upstream
fakeas zone https://localhost:$UPSTREAM_PORT/header/=zone-header-key@header.json https://localhost:$UPSTREAM_PORT/query/=zone-query-key@query.json https://localhost:$UPSTREAM_PORT/cookie/=zone-cookie-key@cookie.json https://localhost:$UPSTREAM_PORT/scheme/=zone-scheme-key@scheme.json https://localhost:$UPSTREAM_PORT/password/=zone-password@password.json https://localhost:$UPSTREAM_PORT/bearer/=zone-bearer-token https://localhost:$UPSTREAM_PORT/dpop/=zone-dpop-token@dpop.json https://localhost:$UPSTREAM_PORT/banned/=zone-banned-key@banned.json
freeport PROXY_PORT
shortdir ADMIN_DIR
chmod 0777 $ADMIN_DIR
chmod 0600 client-secret
expand config.yaml

env EGRESS_PROXY_CONFIG=config.yaml
env EGRESS_PROXY_SANDBOX_ID=acceptance
env EGRESS_PROXY_CONNECT=127.0.0.1:$PROXY_PORT
env EGRESS_PROXY_ADMIN=$ADMIN_DIR/admin.sock
env EGRESS_PROXY_CA_OUT_DIR=$WORK/shared-ca
env EGRESS_PROXY_UPSTREAM_CA_FILES=$WORK/upstream/ca.crt,$WORK/zone/ca.crt
env EGRESS_PROXY_CLIENT_SECRET_FILE=$WORK/client-secret
exec egress-proxy &proxy&
waitfile shared-ca/ca.crt
waitport 127.0.0.1:$PROXY_PORT

env HTTPS_PROXY=http://127.0.0.1:$PROXY_PORT

# Every request sends a placeholder at the endpoint placement and at the
# place the method names.
exec curl -sS --cacert shared-ca/ca.crt -H 'Authorization: Bearer placeholder' -H 'X-Api-Key: placeholder' https://localhost:$UPSTREAM_PORT/header/things
stdout '^hello from upstream /header/things$'
exec curl -sS --cacert shared-ca/ca.crt -H 'Authorization: Bearer placeholder' 'https://localhost:'$UPSTREAM_PORT'/query/things?q=here&api_key=placeholder'
stdout '^hello from upstream /query/things$'
exec curl -sS --cacert shared-ca/ca.crt -H 'Authorization: Bearer placeholder' -H 'Cookie: session=abc; sid=placeholder' https://localhost:$UPSTREAM_PORT/cookie/things
stdout '^hello from upstream /cookie/things$'
exec curl -sS --cacert shared-ca/ca.crt -H 'Authorization: Bearer placeholder' https://localhost:$UPSTREAM_PORT/scheme/things
stdout '^hello from upstream /scheme/things$'
exec curl -sS --cacert shared-ca/ca.crt -H 'Authorization: Bearer placeholder' -H 'X-Username: placeholder' 'https://localhost:'$UPSTREAM_PORT'/password/things?password=placeholder'
stdout '^hello from upstream /password/things$'
exec curl -sS --cacert shared-ca/ca.crt -H 'Authorization: Bearer placeholder' https://localhost:$UPSTREAM_PORT/bearer/things
stdout '^hello from upstream /bearer/things$'
exec curl -sS --cacert shared-ca/ca.crt -H 'Authorization: Bearer placeholder' -o /dev/null -w '%{http_code}' https://localhost:$UPSTREAM_PORT/dpop/things
stdout '^403$'
exec curl -sS --cacert shared-ca/ca.crt -H 'Authorization: Bearer placeholder' -o /dev/null -w '%{http_code}' https://localhost:$UPSTREAM_PORT/banned/things
stdout '^403$'

# Keycard-API-Key in a header. The endpoint placement is not written, so the
# workload's Authorization arrives as it sent it.
grep 'request GET /header/things host=localhost:\d+ authorization="Bearer placeholder"' upstream/requests.log
grep '^  header X-Api-Key="zone-header-key"$' upstream/requests.log

# Keycard-API-Key in the query, in place of the workload's parameter.
grep 'request GET /query/things\?q=here&api_key=zone-query-key host=localhost:\d+ authorization="Bearer placeholder"' upstream/requests.log

# Keycard-API-Key in a cookie, beside the workload's other cookies.
grep '^  header Cookie="session=abc; sid=zone-cookie-key"$' upstream/requests.log

# Keycard-API-Key as an Authorization scheme with a parameter.
grep 'request GET /scheme/things host=localhost:\d+ authorization="Token token=zone-scheme-key"' upstream/requests.log

# Keycard-Password: the username in a header and the password in the query.
grep 'request GET /password/things\?password=zone-password host=localhost:\d+ authorization="Bearer placeholder"' upstream/requests.log
grep '^  header X-Username="svc-user"$' upstream/requests.log

# Bearer goes where the endpoint placement says.
grep 'request GET /bearer/things host=localhost:\d+ authorization="Bearer zone-bearer-token"' upstream/requests.log

# The refused requests never reached the upstream.
! grep '/dpop/things' upstream/requests.log
! grep '/banned/things' upstream/requests.log
grep -count=6 '^request ' upstream/requests.log

sigterm
wait proxy

audit stdout scope=request request.path=/header/things decision.reason=endpoint_allowed outcome.status=200
audit stdout scope=request request.path=/password/things decision.reason=endpoint_allowed outcome.status=200
audit stdout scope=request request.path=/bearer/things decision.reason=endpoint_allowed outcome.status=200
audit stdout scope=request request.path=/dpop/things decision.verdict=deny decision.reason=credential_unavailable decision.endpoint=localhost:$UPSTREAM_PORT/dpop/
audit stdout scope=request request.path=/banned/things decision.verdict=deny decision.reason=credential_unavailable decision.endpoint=localhost:$UPSTREAM_PORT/banned/
stdout 'unsupported_token_type for token_type \\"DPoP\\"'
stdout 'header name \\"Proxy-Authorization\\" in method.name is not allowed'

# The audit stream and log contain no credential, username or secret.
! stdout 'zone-header-key|zone-query-key|zone-cookie-key|zone-scheme-key|zone-password|zone-bearer-token|zone-dpop-token|zone-banned-key|svc-user'
! stderr 'zone-header-key|zone-query-key|zone-cookie-key|zone-scheme-key|zone-password|zone-bearer-token|zone-dpop-token|zone-banned-key|svc-user'
! stdout 'acceptance-client-secret'
! stderr 'acceptance-client-secret'

-- header.json --
{"token_type": "Keycard-API-Key", "method": {"in": "header", "name": "X-Api-Key"}}
-- query.json --
{"token_type": "Keycard-API-Key", "method": {"in": "query", "name": "api_key"}}
-- cookie.json --
{"token_type": "Keycard-API-Key", "method": {"in": "cookie", "name": "sid"}}
-- scheme.json --
{"token_type": "Keycard-API-Key", "method": {"in": "scheme", "name": "Token", "scheme_parameter": "token"}}
-- password.json --
{"token_type": "Keycard-Password", "username": "svc-user", "method": {"username": {"in": "header", "name": "X-Username"}, "password": {"in": "query", "name": "password"}}}
-- dpop.json --
{"token_type": "DPoP"}
-- banned.json --
{"token_type": "Keycard-API-Key", "method": {"in": "header", "name": "Proxy-Authorization"}}
-- config.yaml --
version: 1
identity:
  zone_url: "https://localhost:$ZONE_PORT"
  client_id: "$ZONE_CLIENT_ID"
  client_secret_file: "/replaced/by/the/environment"
  impersonate:
    user: "igmua2g0fwapl21qll7tczdw7t"
policy:
  deny_list_exceptions: ["127.0.0.0/8", "::1/128"]
endpoints:
  - url: https://localhost:$UPSTREAM_PORT/header/
    credential:
      placement: {kind: header, name: Authorization, template: "Bearer {credential}"}
  - url: https://localhost:$UPSTREAM_PORT/query/
    credential:
      placement: {kind: header, name: Authorization, template: "Bearer {credential}"}
  - url: https://localhost:$UPSTREAM_PORT/cookie/
    credential:
      placement: {kind: header, name: Authorization, template: "Bearer {credential}"}
  - url: https://localhost:$UPSTREAM_PORT/scheme/
    credential:
      placement: {kind: query, name: key}
  - url: https://localhost:$UPSTREAM_PORT/password/
    credential:
      placement: {kind: header, name: Authorization, template: "Bearer {credential}"}
  - url: https://localhost:$UPSTREAM_PORT/bearer/
    credential:
      placement: {kind: header, name: Authorization, template: "Bearer {credential}"}
  - url: https://localhost:$UPSTREAM_PORT/dpop/
    credential:
      placement: {kind: header, name: Authorization, template: "Bearer {credential}"}
  - url: https://localhost:$UPSTREAM_PORT/banned/
    credential:
      placement: {kind: header, name: Authorization, template: "Bearer {credential}"}
-- client-secret --
acceptance-client-secret
